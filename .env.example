# EmailJS — https://www.emailjs.com/
# Public Key: Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Service ID: Email Services → pilih service → Service ID
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Template ID: Email Templates → pilih template → Template ID
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Opsional — email yang ditampilkan di section kontak
VITE_CONTACT_EMAIL=your_email_here@gmail.com
